---
import Layout from '../../layouts/Layout.astro';
import Sources from '../../components/Sources.astro';
import {getCollection,getEntry,render} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('updates')).map(update=>({params:{id:update.id},props:{update}}));}
const {update}=Astro.props;
const films=await Promise.all(update.data.films.map(f=>getEntry(f)));
const artists=await Promise.all(update.data.artists.map(a=>getEntry(a)));
if(films.some(f=>!f)||artists.some(a=>!a))throw new Error(`Missing reference in ${update.id}`);
const {Content}=await render(update);
---
<Layout title={update.data.title} description={update.data.description}><div class="page-head"><a class="back" href="/journal/">← The journal</a><p class="eyebrow" style="margin-top:28px"><time datetime={update.data.date}>{update.data.date}</time> / FIELD NOTE</p><h1>{update.data.title}</h1><p>{update.data.description}</p></div><div class="article-layout"><article class="prose"><Content/></article><aside class="facts"><p class="eyebrow">IN THIS NOTE</p>{films.map(f=>f&&<p style="margin-top:16px"><a href={`/films/${f.id}/`}>{f.data.title} ↗</a></p>)}{artists.map(a=>a&&<p style="margin-top:16px"><a href={`/artists/${a.id}/`}>{a.data.title} ↗</a></p>)}<Sources sources={update.data.sources}/></aside></div></Layout>
