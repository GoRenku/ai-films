---
import Layout from '../layouts/Layout.astro';
import FilmCard from '../components/FilmCard.astro';
import {getCollection} from 'astro:content';
const films = (await getCollection('films')).sort((a,b)=>a.data.order-b.data.order);
const artists = (await getCollection('artists')).sort((a,b)=>Number(b.data.featured)-Number(a.data.featured)||a.data.title.localeCompare(b.data.title));
const updates = (await getCollection('updates')).sort((a,b)=>b.data.date.localeCompare(a.data.date));
const hero = films.find(f=>f.data.featured) ?? films[0];
const creator = artists.find(a=>a.id===hero.data.artist.id);
---
<Layout><section class="intro"><div><p class="eyebrow"><span class="dot">●</span> THE ONGOING COLLECTION</p><h1>A new medium.<br/><em>A human vision.</em></h1></div><p class="intro-note">Films worth watching.<br/>Artists worth following.<br/><span>An open-ended look at AI cinema.</span></p></section><section class="feature" aria-label="Featured film"><img class="feature-image" src={hero.data.image} alt={hero.data.imageAlt} fetchpriority="high" width="1280" height="720"/><div class="feature-shade"></div><div class="feature-top"><span class="eyebrow">IN FOCUS / 01</span><span>{hero.data.genre} <span class="dot">·</span> {hero.data.runtimeMinutes} min</span></div><div class="feature-copy"><p class="eyebrow">{creator?.data.alias ?? creator?.data.title}</p><h2><a href={`/films/${hero.id}/`}>{hero.data.title}</a></h2><p>{hero.data.description}</p><a class="button" href={`/films/${hero.id}/`}>Explore the film <span aria-hidden="true">↗</span></a></div><a class="feature-credit" href={hero.data.imageSource}>{hero.data.imageCredit}</a></section><section class="collection section-space"><div class="section-heading"><div><p class="eyebrow">THE SCREENING ROOM</p><h2>Stories taking shape.</h2></div><a class="text-link" href="/films/">All films <span>↗</span></a></div><div class="film-grid">{films.slice(0,6).map(film=><FilmCard film={film} artist={artists.find(a=>a.id===film.data.artist.id)}/>)}</div></section><section class="artists-strip section-space"><div class="section-heading"><div><p class="eyebrow">BEHIND THE FRAME</p><h2>The people making it.</h2></div><a class="text-link" href="/artists/">Meet the artists ↗</a></div><div class="artist-list">{artists.slice(0,4).map((a,i)=><a class="artist-row" href={`/artists/${a.id}/`}><span class="index">0{i+1}</span><div><h3>{a.data.title}</h3><p>{a.data.alias ?? a.data.focus}</p></div><span class="artist-focus">{a.data.focus}</span><span aria-hidden="true">↗</span></a>)}</div></section>{updates.length>0&&<section class="section-space"><div class="section-heading"><div><p class="eyebrow">FIELD NOTES</p><h2>From the journal.</h2></div><a class="text-link" href="/journal/">All updates ↗</a></div><div class="journal-grid">{updates.slice(0,3).map(u=><a class="journal-card" href={`/journal/${u.id}/`}><time datetime={u.data.date}>{u.data.date}</time><h3>{u.data.title}</h3><p>{u.data.description}</p><span class="text-link">Read the note ↗</span></a>)}</div></section>}</Layout>
