---
import '@fontsource-variable/fraunces/index.css';
import '../styles/global.css';
const {title = 'AI Film Journal', description = 'An ongoing collection of films, artists and new possibilities in AI cinema.'} = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#12100d"/><link rel="icon" href="/favicon.svg"/><title>{title === 'AI Film Journal' ? title : `${title} — AI Film Journal`}</title></head><body><a class="skip" href="#main">Skip to content</a><header class="site-header"><a class="brand" href="/" aria-label="AI Film Journal home"><span class="brand-mark">aı<span>•</span></span><span>FILM JOURNAL</span></a><nav aria-label="Main navigation"><a href="/" aria-current={path==='/'?'page':undefined}>Discover</a><a href="/whats-new/" aria-current={path.startsWith('/whats-new/')?'page':undefined}>What’s New</a><a href="/films/" aria-current={path.startsWith('/films/')?'page':undefined}>Films</a><a href="/artists/" aria-current={path.startsWith('/artists/')?'page':undefined}>Artists</a><a href="/journal/" aria-current={path.startsWith('/journal/')?'page':undefined}>Journal</a></nav><span class="header-note">HUMAN VISION. NEW MEDIUM.</span></header><main id="main"><slot/></main><footer><a class="brand footer-brand" href="/">AI Film Journal<span class="dot">●</span></a><p>An independent watch on the people making AI cinema.</p><a href="/about/">About the collection ↗</a></footer></body></html>
