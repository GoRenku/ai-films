---
import type { Film, Artist } from '../lib/catalog';
import { embedOf, genresOf, lengthOf, statusKey, statusLabel } from '../lib/catalog';
import PlayIcon from './PlayIcon.astro';
// fresh: the badge from the catalog's freshOf — New, or New episode for a continuing series.
interface Props { film: Film; artist: Artist; fresh?: string; filterable?: boolean; eager?: boolean }
const { film, artist, fresh, filterable = false, eager = false } = Astro.props;
const d = film.data;
const embed = d.status === 'Watch now' ? embedOf(d.watchUrl) : undefined;
const meta = [artist.data.title, d.format === 'Short film' ? 'Short' : d.format, lengthOf(film) ?? d.year].join(' · ');
const data = filterable
  ? {
      'data-title': `${d.title} ${artist.data.title} ${artist.data.alias ?? ''} ${d.genre} ${d.format} ${d.musician ?? ''}`.toLowerCase(),
      'data-status': d.status,
      'data-format': d.format,
      'data-genres': genresOf(d.genre).join('|'),
      'data-added': d.discoveredAt,
      'data-year': d.year,
      'data-runtime': d.runtimeMinutes ?? d.episodes.reduce((sum, e) => sum + (e.runtimeMinutes ?? 0), 0),
      'data-name': d.title.toLowerCase(),
    }
  : {};
---
<article class="card" {...data}>
  <a class="card-link" href={`/films/${film.id}/`} data-morph>
    <div class:list={['card-media', d.imageFit === 'contain' && 'is-contain']} data-morph-media style={d.image ? `--img:url('${d.image}')` : undefined}>
      {d.image ? <img src={d.image} alt={d.imageAlt} loading={eager ? 'eager' : 'lazy'} decoding="async" width="800" height="450" /> : <span class="title-art" aria-hidden="true">{d.title}</span>}
      <span class="card-tags">
        {fresh && <span class="tag-new">{fresh}</span>}
        <span class={`pill pill-${statusKey(d.status)}`}>{statusLabel(d.status)}</span>
      </span>
    </div>
    <h3>{d.title}</h3>
    <p class="card-meta">{meta}</p>
  </a>
  {embed && <button class="card-play" type="button" data-play={embed.src} data-title={d.title} data-source={d.watchUrl} aria-label={`Play ${d.title}`}><PlayIcon /></button>}
</article>
