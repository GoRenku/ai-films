---
const { film, artist } = Astro.props;
---
<article class="film-card"><a class="image-link" href={`/films/${film.id}/`} aria-label={`Explore ${film.data.title}`}>{film.data.image?<img src={film.data.image} alt={film.data.imageAlt} loading="lazy" width="800" height="450"/>:<div class="film-title-art" aria-hidden="true"><span>FILM NOTES</span><strong>{film.data.title}</strong></div>}<span class="image-label">{film.data.format}</span><span class="round-arrow" aria-hidden="true">↗</span></a><div class="card-meta"><span>{film.data.genre}</span><span>{film.data.runtimeMinutes ? `${film.data.runtimeMinutes} min` : film.data.year}</span></div><h3><a href={`/films/${film.id}/`}>{film.data.title}</a></h3><p class="artist-line">{artist?.data.title}{artist?.data.alias && ` / ${artist.data.alias}`}</p><p>{film.data.description}</p></article>
