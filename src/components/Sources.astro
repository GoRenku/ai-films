---
interface Props { sources: { url: string; label: string }[]; checked?: string }
const { sources, checked } = Astro.props;
---
<details class="sources">
  <summary><span>Sources</span><span class="sources-count">{sources.length}</span>{checked && <span class="sources-checked">checked <time datetime={checked}>{checked}</time></span>}</summary>
  <ul>{sources.map((s) => <li><a href={s.url} rel="noopener noreferrer">{s.label} ↗</a></li>)}</ul>
</details>
